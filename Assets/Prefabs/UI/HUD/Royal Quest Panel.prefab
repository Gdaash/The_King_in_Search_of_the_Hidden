    - target: {fileID: 2521177715420957826, guid: 06d33e6ac33b0bb428699f3a5625ec2a, type: 3}
      propertyPath: m_Text
      value: "\u041F\u0440\u0438\u043A\u0430\u0437 \u043A\u043E\u0440\u043E\u043B\u044F:
        \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0443\u044E
        \u0440\u0443\u0434\u0443 \u0432 \u043A\u0430\u0437\u043D\u0443 \u0434\u043E
        \u0438\u0441\u0442\u0435\u0447\u0435\u043D\u0438\u044F \u0441\u0440\u043E\u043A\u0430.
        \u041F\u0440\u0438 \u043F\u0440\u043E\u0432\u0430\u043B\u0435 \u0431\u0443\u0434\u0443\u0442
        \u043A\u043E\u043D\u0444\u0438\u0441\u043A\u043E\u0432\u0430\u043D\u044B
        \u0435\u0434\u0430, \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B
        \u0438 \u043E\u0440\u0443\u0436\u0438\u0435. \u041B\u044E\u0434\u0438, \u0432\u043E\u0438\u043D\u044B
        \u0438 \u0442\u0435\u043B\u0435\u0433\u0438 \u043E\u0441\u0442\u0430\u043D\u0443\u0442\u0441\u044F."
      objectReference: {fileID: 0}
    - target: {fileID: 3888113791602406569, guid: 06d33e6ac33b0bb428699f3a5625ec2a, type: 3}
