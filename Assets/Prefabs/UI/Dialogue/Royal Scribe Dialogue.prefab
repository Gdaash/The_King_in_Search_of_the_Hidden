      m_Calls: []
  m_text: "\u0412\u0430\u0448\u0435 \u0412\u0435\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E,
    \u0443\u043A\u0440\u044B\u0442\u0438\u044E \u043D\u0443\u0436\u043D\u044B \u043F\u0440\u0438\u043F\u0430\u0441\u044B.\n\u041E\u0442\u043F\u0440\u0430\u0432\u044C\u0442\u0435
    \u043B\u044E\u0434\u0435\u0439 \u0447\u0435\u0440\u0435\u0437 \u043F\u043E\u0440\u0442\u0430\u043B
    \u0438 \u0434\u043E\u0431\u0443\u0434\u044C\u0442\u0435 \u0435\u0434\u0443, \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u0443
    \u0438 \u043A\u0430\u043C\u0435\u043D\u044C. \u042F \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u044E
    \u0434\u043B\u044F \u0432\u0430\u0441 \u043F\u0435\u0440\u0432\u043E\u0435 \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u0435."
  m_isRightToLeft: 0
