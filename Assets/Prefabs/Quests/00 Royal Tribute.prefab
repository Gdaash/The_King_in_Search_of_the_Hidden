  m_Script: {fileID: 11500000, guid: 895904b1fa67d4e4eb237c37cd409e19, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameFoundation.Quests.QuestDialogueDefinition
  id: scribe_royal_magic_tribute
  speakerName: "\u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0438\u0439
    \u043F\u0438\u0441\u0430\u0440\u044C"
  portrait: {fileID: 21300000, guid: 33a5a8bda38890c409d5c7f237c62396, type: 3}
  lines:
  - "\u0421\u043B\u0443\u0448\u0430\u0439 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E,
    \u0440\u044B\u0446\u0430\u0440\u044C. \u041A\u043E\u0440\u043E\u043B\u044E \u043D\u0435\u0442
    \u0434\u0435\u043B\u0430 \u0434\u043E \u0442\u0432\u043E\u0438\u0445 \u0436\u0430\u043B\u043A\u0438\u0445
    \u0442\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u0435\u0439. \u0427\u0435\u0440\u0435\u0437
    \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0434\u043D\u0435\u0439 \u0442\u044B
    \u0441\u0434\u0430\u0448\u044C \u0432 \u043A\u0430\u0437\u043D\u0443 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C
    \u0435\u0434\u0438\u043D\u0438\u0446 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0440\u0443\u0434\u044B. \u041D\u0435 \u0432\u0437\u0434\u0443\u043C\u0430\u0439
    \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C \u043D\u0430\u0441
    \u0436\u0434\u0430\u0442\u044C."
  - "\u0418\u0441\u043F\u043E\u043B\u043D\u0438\u0448\u044C \u043F\u0440\u0438\u043A\u0430\u0437
    \u2014 \u043F\u043E\u043B\u0443\u0447\u0438\u0448\u044C \u0434\u0435\u0441\u044F\u0442\u044C
    \u0432\u043B\u0438\u044F\u043D\u0438\u044F. \u041E\u043F\u043E\u0437\u0434\u0430\u0435\u0448\u044C
    \u2014 \u043B\u0438\u0448\u0438\u0448\u044C\u0441\u044F \u0432\u0441\u0435\u0445
    \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432, \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432
    \u0438 \u043E\u0440\u0443\u0436\u0438\u044F, \u0430 \u0442\u0432\u043E\u0451
    \u0432\u043B\u0438\u044F\u043D\u0438\u0435 \u0443\u043C\u0435\u043D\u044C\u0448\u0438\u0442\u0441\u044F
    \u043D\u0430 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C. \u041B\u044E\u0434\u0435\u0439
    \u0438 \u0442\u0435\u043B\u0435\u0433\u0438 \u043F\u043E\u043A\u0430 \u043E\u0441\u0442\u0430\u0432\u0438\u043C.
    \u0421\u0447\u0438\u0442\u0430\u0439 \u044D\u0442\u043E \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u043E\u0439
    \u043C\u0438\u043B\u043E\u0441\u0442\u044C\u044E."
  quest: {fileID: 11400000, guid: e0c0e9b8b79e6554bafe380c01ea59f4, type: 2}
  prerequisite: {fileID: 0}
  prerequisiteAccepted: 0
