  m_EditorClassIdentifier: Assembly-CSharp::GameFoundation.Quests.QuestDialogueDefinition
  id: pew_first_weapon_enhancement
  allowOverPopups: 0
  speakerName: "\u0421\u0442\u0430\u0439\u043A \u041F\u044C\u044E"
  portrait: {fileID: 21300000, guid: 7f63647c8814e9c45beac1800bb69fd6, type: 3}
  lines:
  - "\u0414\u0432\u0430 \u043E\u0441\u044C\u043C\u0438\u043D\u043E\u0433\u0430 \u0443\u0436\u0435
    \u043F\u043E\u0432\u0435\u0440\u0436\u0435\u043D\u044B. \u042F \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u043B\u0441\u044F,
    \u043A\u0430\u043A \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0441\u043D\u0430\u0440\u044F\u0434\u044B \u0431\u0438\u0442\u044C \u0441\u0438\u043B\u044C\u043D\u0435\u0435
    \u0438 \u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C \u0447\u0430\u0449\u0435."
  - "\u0417\u0430\u0433\u043B\u044F\u043D\u0438 \u0432 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0431\u0430\u0448\u043D\u044E \u0438 \u0443\u0441\u0438\u043B\u044C \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0441\u043D\u0430\u0440\u044F\u0434\u044B. \u0414\u043B\u044F \u044D\u0442\u043E\u0433\u043E
    \u0445\u0432\u0430\u0442\u0438\u0442 \u043D\u0430\u0448\u0435\u0433\u043E \u0431\u043E\u0435\u0432\u043E\u0433\u043E
    \u043E\u043F\u044B\u0442\u0430 \u2013 \u0440\u0443\u0434\u0430 \u043D\u0435 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F."
