  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 895904b1fa67d4e4eb237c37cd409e19, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameFoundation.Quests.QuestDialogueDefinition
  id: pew_first_supplies
  speakerName: "\u0421\u0442\u0430\u0439\u043A \u041F\u044C\u044E"
  portrait: {fileID: 21300000, guid: 7f63647c8814e9c45beac1800bb69fd6, type: 3}
  lines:
  - "Привет! Добро пожаловать в земли портала! Значит, ты наш новый владелец? Я Стайк Пью. Буду помогать тебе восстанавливать здешнее хозяйство. Работы хватает, зато на недостаток свежего воздуха никто не жалуется!"
  - "С тобой прибыли семеро поселенцев. Люди хорошие, только с дороги проголодались. На всех нужно семь порций еды. И крыша над головой нужна, хоть какая-нибудь. Пора строить жилой квартал."
  - "\u0417\u0430 \u043F\u043E\u0440\u0442\u0430\u043B\u043E\u043C \u043B\u0435\u0436\u0430\u0442
    \u0422\u0451\u043C\u043D\u044B\u0435 \u0437\u0435\u043C\u043B\u0438. \u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
    \u043D\u0435\u043F\u0440\u0438\u0432\u0435\u0442\u043B\u0438\u0432\u043E\u0435,
    \u043D\u043E \u0435\u0434\u0430 \u0438 \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u0430
    \u0442\u0430\u043C \u043D\u0430\u0439\u0434\u0443\u0442\u0441\u044F. \u041F\u0440\u0438\u043D\u0435\u0441\u0438
    \u0441\u0435\u043C\u044C \u043F\u043E\u0440\u0446\u0438\u0439 \u0435\u0434\u044B
    \u0438 \u043F\u044F\u0442\u044C \u0441\u0432\u044F\u0437\u043E\u043A \u0434\u0435\u0440\u0435\u0432\u0430.
    \u042F \u043F\u043E\u043A\u0430 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u044E
    \u043C\u0435\u0441\u0442\u043E \u0434\u043B\u044F \u0431\u0443\u0434\u0443\u0449\u0438\u0445
    \u0434\u043E\u043C\u043E\u0432. \u041D\u0430\u0447\u043D\u0451\u043C \u0441 \u043C\u0430\u043B\u043E\u0433\u043E
    \u2013 \u043D\u0430\u043A\u043E\u0440\u043C\u0438\u043C \u043B\u044E\u0434\u0435\u0439
    \u0438 \u0434\u0430\u0434\u0438\u043C \u0438\u043C \u043A\u0440\u044B\u0448\u0443
    \u043D\u0430\u0434 \u0433\u043E\u043B\u043E\u0432\u043E\u0439."
  quest: {fileID: 11400000, guid: 032ec081eb34d4644904444ea6142470, type: 2}
