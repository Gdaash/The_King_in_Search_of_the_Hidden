  m_Script: {fileID: 11500000, guid: 895904b1fa67d4e4eb237c37cd409e19, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameFoundation.Quests.QuestDialogueDefinition
  id: pew_smithy_materials
  speakerName: "\u0421\u0442\u0430\u0440\u0438\u043A \u041F\u044C\u044E"
  portrait: {fileID: 21300000, guid: 7f63647c8814e9c45beac1800bb69fd6, type: 3}
  lines:
  - "\u0422\u0435\u043F\u0435\u0440\u044C \u0443 \u043B\u044E\u0434\u0435\u0439 \u0435\u0441\u0442\u044C
    \u043A\u0440\u044B\u0448\u0430 \u043D\u0430\u0434 \u0433\u043E\u043B\u043E\u0432\u043E\u0439.
    \u041F\u043E\u0440\u0430 \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0437\u0430\u0449\u0438\u0442\u0443:
    \u0441\u043E\u0431\u0435\u0440\u0438 \u0434\u0435\u0440\u0435\u0432\u043E \u0438
    \u043A\u0430\u043C\u0435\u043D\u044C \u0434\u043B\u044F \u043A\u0443\u0437\u043D\u0438\u0446\u044B,
    \u0434\u0432\u0443\u0445 \u043B\u0443\u043A\u043E\u0432 \u0438 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0438\u0449\u0430.
    \u0417\u0430\u0442\u0435\u043C \u0441\u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C
    \u043A\u0443\u0437\u043D\u0438\u0446\u0443."
  - "\u042F \u043E\u0442\u043A\u0440\u043E\u044E \u0442\u0435\u0431\u0435 \u0441\u0435\u043A\u0440\u0435\u0442
    \xAB\u041A\u0440\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u044D\u0433\u0438\u0434\u044B\xBB.
    \u041A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u044B, \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u0435
    \u0437\u0430 \u043F\u043E\u0440\u0442\u0430\u043B\u043E\u043C, \u043F\u0438\u0442\u0430\u044E\u0442
    \u043E\u0440\u0443\u0436\u0438\u0435 \u0431\u0430\u0448\u043D\u0438. \u041D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u0438
    \u0434\u043E\u0441\u0442\u0430\u0432\u044F\u0442 \u0438\u0445 \u043A \u043F\u043E\u0440\u0442\u0430\u043B\u0443,
    \u0430 \u0442\u044B \u0432\u044B\u0431\u0435\u0440\u0435\u0448\u044C \u043E\u0440\u0443\u0436\u0438\u0435
    \u0438 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F, \u0447\u0442\u043E\u0431\u044B
    \u0434\u0430\u0442\u044C \u043E\u0442\u043F\u043E\u0440 \u0447\u0443\u0434\u043E\u0432\u0438\u0449\u0430\u043C.
    \u041F\u0435\u0440\u0435\u0434 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u043C
    \u043F\u043E\u0445\u043E\u0434\u043E\u043C \u0431\u0430\u0448\u043D\u044F \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442
    \u0442\u0435\u0431\u0435 \u043F\u0435\u0440\u0432\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435."
  quest: {fileID: 11400000, guid: 541fd17b5223694489a6cde430ecd6bd, type: 2}
  prerequisite: {fileID: 11400000, guid: 032ec081eb34d4644904444ea6142470, type: 2}
