  m_EditorClassIdentifier: Assembly-CSharp::GameFoundation.Quests.QuestDialogueDefinition
  id: pew_smithy_two_bows
  speakerName: "\u0421\u0442\u0430\u0440\u0438\u043A \u041F\u044C\u044E"
  portrait: {fileID: 21300000, guid: 7f63647c8814e9c45beac1800bb69fd6, type: 3}
  lines:
  - "\u041F\u0440\u0438\u043F\u0430\u0441\u044B \u0441\u043E\u0431\u0440\u0430\u043D\u044B.
    \u0422\u0435\u043F\u0435\u0440\u044C \u043F\u043E\u0441\u0442\u0440\u043E\u0439
    \u043A\u0443\u0437\u043D\u0438\u0446\u0443 \u0438 \u0441\u0434\u0435\u043B\u0430\u0439
    \u0434\u0432\u0430 \u043B\u0443\u043A\u0430. \u041A\u043E\u0433\u0434\u0430 \u043E\u0440\u0443\u0436\u0438\u0435
    \u0431\u0443\u0434\u0435\u0442 \u0433\u043E\u0442\u043E\u0432\u043E, \u043C\u044B
    \u043E\u0442\u043A\u0440\u043E\u0435\u043C \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0438\u0449\u0435
    \u0434\u043B\u044F \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u044F \u0437\u0430\u0449\u0438\u0442\u043D\u0438\u043A\u043E\u0432."
  quest: {fileID: 11400000, guid: 718ee3298b7f13341b659a5355cdc55d, type: 2}
  prerequisite: {fileID: 11400000, guid: 032ec081eb34d4644904444ea6142470, type: 2}
