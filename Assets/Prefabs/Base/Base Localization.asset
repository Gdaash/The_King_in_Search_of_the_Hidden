  - key: skill.Flashlight2.description
    values:
    - "\u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0432\u0442\u043E\u0440\u043E\u0439
      \u0444\u043E\u043D\u0430\u0440\u044C \u0434\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u044B
      \u0441 \u0433\u0435\u043A\u0441\u0430\u043C\u0438."
