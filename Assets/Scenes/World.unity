  DialogContent:
  - LanguageKey: English
    Value:
    - CharacterSprite: {fileID: 21300000, guid: 5e4f83fcc0bff8b4c8ac9f5850420842, type: 3}
      Value: "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E, \u0432\u0430\u0448\u0435
        \u0432\u044B\u0441\u043E\u0447\u0435\u0441\u0442\u0432\u043E. \u0425\u043E\u0440\u043E\u0448\u043E
        \u0441\u043F\u0430\u043B\u043E\u0441\u044C? \u041F\u043E\u043A\u0430 \u0432\u044B
        \u0441\u043F\u0430\u043B\u0438 \u0432\u0441\u0451 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u043E
        \u0441\u043D\u043E\u0432\u0430 \u043F\u043E\u043A\u0440\u044B\u043B\u043E\u0441\u044C
        \u0433\u0435\u043A\u0441\u0430\u043C\u0438."
      Event:
        m_PersistentCalls:
          m_Calls: []
    - CharacterSprite: {fileID: 21300000, guid: 5e4f83fcc0bff8b4c8ac9f5850420842, type: 3}
      Value: "\u041C\u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043E\u0442\u0431\u0438\u0442\u044C
        \u043D\u0430\u0448 \u0437\u0430\u043C\u043E\u043A, \u0434\u043E\u043C \u043B\u0435\u0441\u043E\u0440\u0443\u0431\u043E\u0432
        \u0438 \u0441\u0431\u043E\u0440\u0449\u0438\u043A\u043E\u0432 \u044F\u0433\u043E\u0434."
      Event:
        m_PersistentCalls:
          m_Calls: []
    - CharacterSprite: {fileID: 21300000, guid: 5e4f83fcc0bff8b4c8ac9f5850420842, type: 3}
      Value: "\u0412\u044B \u0435\u0449\u0451 \u043F\u043E\u043C\u043D\u0438\u0442\u0435
        \u043A\u0430\u043A \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C
        \u043F\u043E\u0434\u0434\u0430\u043D\u043D\u044B\u043C\u0438? \u041D\u0430\u0440\u043E\u0434\u0443
        \u043D\u0443\u0436\u043D\u0430 \u0432\u0430\u0448\u0430 \u0434\u043B\u0430\u043D\u044C."
      Event:
        m_PersistentCalls:
          m_Calls: []
