    \u041D\u0430\u0436\u043C\u0438 \"\u0412\u043E\u043E\u0440\u0443\u0436\u0438\u0442\u044C\"
    \u0434\u0432\u0430\u0436\u0434\u044B. \u0414\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E
    \u043F\u0440\u0430\u0449\u043D\u0438\u043A\u0430 \u043D\u0443\u0436\u0435\u043D
    \u043E\u0434\u0438\u043D \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0439
    \u0436\u0438\u0442\u0435\u043B\u044C."
  inProgressStatus: "\u041D\u0430\u0439\u043C\u0438 \u0434\u0432\u0443\u0445 \u043F\u0440\u0430\u0449\u043D\u0438\u043A\u043E\u0432"
