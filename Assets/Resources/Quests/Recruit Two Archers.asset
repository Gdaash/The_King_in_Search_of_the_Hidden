  id: recruit_two_archers
  title: "\u041F\u0435\u0440\u0432\u044B\u0435 \u0437\u0430\u0449\u0438\u0442\u043D\u0438\u043A\u0438"
  description: "\u0414\u0432\u0430 \u043B\u0443\u043A\u0430 \u0431\u0435\u0437 \u0434\u0435\u043B\u0430
    \u043D\u0435 \u0437\u0430\u0449\u0438\u0442\u044F\u0442 \u0434\u0430\u0436\u0435
    \u043A\u0430\u043F\u0443\u0441\u0442\u043D\u0443\u044E \u0433\u0440\u044F\u0434\u043A\u0443.
    \u041D\u0430\u0439\u043C\u0438 \u0434\u0432\u0443\u0445 \u043B\u0443\u0447\u043D\u0438\u043A\u043E\u0432
    \u0432 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0438\u0449\u0435. \u0421 \u043F\u0435\u0440\u0432\u043E\u0439
    \u0441\u0442\u0440\u0430\u0436\u0435\u0439 \u043C\u043E\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442
    \u0432\u0437\u044F\u0442\u044C\u0441\u044F \u0437\u0430 \u043A\u0443\u0437\u043D\u0438\u0446\u0443
    \u0438 \u0443\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u043B\u0430\u0433\u0435\u0440\u044C
    \u0434\u043B\u044F \u0431\u0435\u0436\u0435\u043D\u0446\u0435\u0432."
  inProgressStatus: "\u041D\u0430\u0439\u043C\u0438 \u0434\u0432\u0443\u0445 \u043B\u0443\u0447\u043D\u0438\u043A\u043E\u0432"
