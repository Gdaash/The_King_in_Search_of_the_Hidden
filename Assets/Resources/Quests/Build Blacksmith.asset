  m_Name: Build Blacksmith
  m_EditorClassIdentifier: Assembly-CSharp::GameFoundation.Quests.QuestDefinition
  id: build_blacksmith
  title: "\u041F\u043E\u0441\u0442\u0440\u043E\u0439 \u0440\u0435\u043C\u0435\u0441\u043B\u0435\u043D\u043D\u044B\u0439
    \u043A\u0432\u0430\u0440\u0442\u0430\u043B"
  description: "\u0417\u0430\u0449\u0438\u0442\u043D\u0438\u043A\u0430\u043C \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F
    \u043E\u0440\u0443\u0436\u0438\u0435. \u041F\u043E\u0441\u0442\u0440\u043E\u0439
    \u0440\u0435\u043C\u0435\u0441\u043B\u0435\u043D\u043D\u044B\u0439 \u043A\u0432\u0430\u0440\u0442\u0430\u043B.
    \u0412 \u0441\u0442\u043E\u043B\u044F\u0440\u043D\u043E\u043C \u0446\u0435\u0445\u0435
    \u043C\u043E\u0436\u043D\u043E \u0434\u0435\u043B\u0430\u0442\u044C \u043A\u043E\u043F\u044C\u044F,
    \u043B\u0443\u043A\u0438 \u0438 \u0442\u0435\u043B\u0435\u0433\u0438. \u0417\u0430
    \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0443 \u0421\u0442\u0430\u0439\u043A
    \u041F\u044C\u044E \u0434\u0430\u0441\u0442 \u0434\u0432\u0435 \u0442\u0435\u043B\u0435\u0433\u0438
    \u0438 \u043E\u0442\u043A\u0440\u043E\u0435\u0442 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u043D\u0430\u0443\u0447\u043D\u043E\u0439 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438
    \u0438 \u043B\u0430\u0433\u0435\u0440\u044F \u0431\u0435\u0436\u0435\u043D\u0446\u0435\u0432."
  inProgressStatus: "\u041F\u043E\u0441\u0442\u0440\u043E\u0439 \u0440\u0435\u043C\u0435\u0441\u043B\u0435\u043D\u043D\u044B\u0439
    \u043A\u0432\u0430\u0440\u0442\u0430\u043B"
