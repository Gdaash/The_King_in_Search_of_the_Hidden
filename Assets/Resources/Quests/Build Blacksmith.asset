    \u0421\u0442\u0430\u0439\u043A \u041F\u044C\u044E \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442
    \u0434\u0432\u0435 \u0442\u0435\u043B\u0435\u0433\u0438 \u0434\u043B\u044F \u043D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u043E\u0432
    \u0438 \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u043D\u0430\u043B\u0430\u0434\u0438\u0442\u044C
    \u043D\u0430\u0443\u0447\u043D\u0443\u044E \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044E."
