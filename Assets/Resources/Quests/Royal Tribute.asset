  m_Name: Royal Tribute
  m_EditorClassIdentifier: Assembly-CSharp::GameFoundation.Quests.QuestDefinition
  id: royal_magic_tribute
  title: "\u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0430\u044F \u0434\u0430\u043D\u044C"
  description: "\u041F\u0440\u0438\u043A\u0430\u0437 \u043A\u043E\u0440\u043E\u043B\u044F:
    \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0440\u0443\u0434\u0443 \u0432 \u043A\u0430\u0437\u043D\u0443 \u0434\u043E \u0438\u0441\u0442\u0435\u0447\u0435\u043D\u0438\u044F
    \u0441\u0440\u043E\u043A\u0430. \u041F\u0440\u0438 \u043F\u0440\u043E\u0432\u0430\u043B\u0435
    \u0431\u0443\u0434\u0443\u0442 \u043A\u043E\u043D\u0444\u0438\u0441\u043A\u043E\u0432\u0430\u043D\u044B
    \u0435\u0434\u0430, \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u0438
    \u043E\u0440\u0443\u0436\u0438\u0435. \u041B\u044E\u0434\u0438, \u0432\u043E\u0438\u043D\u044B
    \u0438 \u0442\u0435\u043B\u0435\u0433\u0438 \u043E\u0441\u0442\u0430\u043D\u0443\u0442\u0441\u044F."
  inProgressStatus: "\u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435 \u0440\u0443\u0434\u0443
    \u0438 \u0441\u0434\u0430\u0439\u0442\u0435 \u0435\u0451 \u0432 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u043E"
