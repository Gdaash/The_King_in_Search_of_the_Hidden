  id: first_expedition_supplies
  title: "\u0415\u0434\u0430 \u0438 \u043A\u0440\u044B\u0448\u0430 \u043D\u0430\u0434
    \u0433\u043E\u043B\u043E\u0432\u043E\u0439"
  description: "\u0421\u0435\u043C\u0435\u0440\u044B\u043C \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0446\u0430\u043C
    \u043D\u0443\u0436\u043D\u044B \u0443\u0436\u0438\u043D \u0438 \u0442\u0451\u043F\u043B\u044B\u0439
    \u043D\u043E\u0447\u043B\u0435\u0433. \u0414\u043E\u0431\u0443\u0434\u044C \u0441\u0435\u043C\u044C
    \u0435\u0434\u0438\u043D\u0438\u0446 \u0435\u0434\u044B \u0438 \u043F\u044F\u0442\u044C
    \u0435\u0434\u0438\u043D\u0438\u0446 \u0434\u0435\u0440\u0435\u0432\u0430 \u0432
    \u0422\u0451\u043C\u043D\u044B\u0445 \u0437\u0435\u043C\u043B\u044F\u0445. \u0421
    \u044D\u0442\u0438\u043C\u0438 \u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C\u0438
    \u0421\u0442\u0430\u0439\u043A \u041F\u044C\u044E \u043F\u043E\u043C\u043E\u0436\u0435\u0442
    \u043D\u0430\u0447\u0430\u0442\u044C \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0436\u0438\u043B\u043E\u0433\u043E \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0430.
    \u0414\u043E \u043D\u043E\u0447\u0438 \u043D\u0443\u0436\u043D\u0430 \u043A\u0440\u044B\u0448\u0430.
    \u0423 \u0431\u0435\u0437\u0434\u043E\u043C\u043D\u043E\u0433\u043E \u0448\u0430\u043D\u0441\u044B
    \u0432\u044B\u0436\u0438\u0442\u044C \u043D\u0430 \u0443\u043B\u0438\u0446\u0435
    \u2013 50 \u043D\u0430 50."
