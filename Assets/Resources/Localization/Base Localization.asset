  - key: game.text.7f2fa2cd485e692d
    values:
    - "\u041E\u0431\u044B\u0449\u0438\u0442\u0435 \u043F\u0435\u0449\u0435\u0440\u044B
      \u0433\u043E\u0431\u043B\u0438\u043D\u043E\u0432. \u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435
