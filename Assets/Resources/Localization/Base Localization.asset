  - key: unit.training.disarm_hint
    values:
    - "\u041F\u0440\u0438 \u0440\u0430\u0437\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0438
      \u0436\u0438\u0442\u0435\u043B\u044C \u0438 \u043E\u0440\u0443\u0436\u0438\u0435
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F \u0432
      \u0437\u0430\u043F\u0430\u0441."
