    values:
    - "\u041A\u0443\u0451\u0442 \u043C\u0435\u0447\u0438 \u0438\u0437 \u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0439
      \u0440\u0443\u0434\u044B \u0438 \u0438\u0437\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u043B\u0443\u043A\u0438 \u0438\u0437 \u0434\u0435\u0440\u0435\u0432\u0430."
