  - key: skill.science.crystal_efficiency.1.description
    values:
    - "\u0423\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u0435
