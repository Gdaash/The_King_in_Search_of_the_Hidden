  - key: intro.begin
    values:
    - "\u041D\u0430\u0436\u043C\u0438\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0430\u0447\u0430\u0442\u044C \u0438\u0433\u0440\u0443"
