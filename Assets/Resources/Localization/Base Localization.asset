    values:
    - "\u0414\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044B
      \u0432 \u043F\u043E\u0440\u0442\u0430\u043B"
