  - key: base.building.fort.description
    values:
    - "\u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0432\u043E\u043E\u0440\u0443\u0436\u0430\u0442\u044C
      \u0436\u0438\u0442\u0435\u043B\u0435\u0439 \u043C\u0435\u0447\u0430\u043C\u0438
      \u0438 \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C \u043C\u0435\u0447\u043D\u0438\u043A\u043E\u0432."
